# Cloudflare custom headers for static assets.
#
# `output: 'export'` cannot emit HTTP headers (Next.js `headers()` is one of the
# unsupported features in a static export), so they are declared here instead.
# Workers reads this file from the root of the assets directory and does not
# serve it; Next copies everything in `public/` into `out/`, so it lands in the
# right place. The same file format works on Pages.
#
# Order matters: later, more specific rules win.

/*
  # Stop browsers from MIME-sniffing a response away from its declared type.
  X-Content-Type-Options: nosniff
  # Send the origin only on cross-origin requests; keeps paths out of referrers.
  Referrer-Policy: strict-origin-when-cross-origin
  # This site is never meant to be framed.
  X-Frame-Options: DENY
  # Nothing on this site uses these APIs; deny them explicitly.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  # Force HTTPS for a year. `preload` is deliberately omitted — submitting to the
  # HSTS preload list is a slow-to-reverse decision and belongs to the owner.
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # No third-party embeds, so isolate the browsing context.
  Cross-Origin-Opener-Policy: same-origin

# Hashed build assets are immutable: the filename changes whenever the content
# does, so they can be cached for a year. Without this they are served with
# `max-age=0, must-revalidate` and every repeat visit re-validates. One splat
# rule covers chunks, CSS and fonts — a splat matches greedily, across path
# separators.
#
# KNOWN COSMETIC QUIRK (measured under `wrangler dev`, not yet on production):
# `.woff2` responses come back with the value twice —
# `public, max-age=31536000, immutable, public, max-age=31536000, immutable`.
# It is not caused by this file: only one rule here matches that path, and root
# probe files with no Cache-Control rule get `max-age=0, must-revalidate`. The
# asset server appears to apply its own immutable default to fonts, and per the
# `_headers` spec a repeated header is joined with a comma. `.css` and `.js`
# under the very same rule are not affected.
#
# Left as-is deliberately. The combined value is functionally identical (RFC
# 9110 parsers read the first `max-age`), whereas narrowing this rule to skip
# `/_next/static/media/*` would drop font caching entirely if production does
# NOT add that default. Confirm against the deployed URL with:
#   curl -sI https://romostransportes.com.mx/_next/static/media/<hash>.woff2
# and only then narrow the rule if the duplicate is real in production.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Photography and brand derivatives are content-addressed by their slug and
# width. They change only when the photo set is regenerated, so cache them for a
# week at the browser and let Cloudflare hold them longer at the edge.
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/brand/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# HTML must always be re-checked so a redeploy is picked up immediately.
/
  Cache-Control: public, max-age=0, must-revalidate

/aviso-de-privacidad/
  Cache-Control: public, max-age=0, must-revalidate
