# Cloudflare Pages custom headers.
#
# `output: 'export'` cannot emit HTTP headers (Next.js `headers()` is one of the
# unsupported features in a static export), so they are declared here instead.
# Cloudflare Pages reads this file from the root of the build output; Next copies
# everything in `public/` into `out/`, so it lands in the right place.
#
# Order matters: later, more specific rules win.

/*
  # Stop browsers from MIME-sniffing a response away from its declared type.
  X-Content-Type-Options: nosniff
  # Send the origin only on cross-origin requests; keeps paths out of referrers.
  Referrer-Policy: strict-origin-when-cross-origin
  # This site is never meant to be framed.
  X-Frame-Options: DENY
  # Nothing on this site uses these APIs; deny them explicitly.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  # Force HTTPS for a year. `preload` is deliberately omitted — submitting to the
  # HSTS preload list is a slow-to-reverse decision and belongs to the owner.
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # No third-party embeds, so isolate the browsing context.
  Cross-Origin-Opener-Policy: same-origin

# Hashed build assets are immutable: the filename changes whenever the content
# does, so they can be cached for a year. Without this, Cloudflare Pages serves
# them with `max-age=0, must-revalidate` and every repeat visit re-validates.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts also carry a content hash in the filename.
/_next/static/media/*
  Cache-Control: public, max-age=31536000, immutable

# Photography and brand derivatives are content-addressed by their slug and
# width. They change only when the photo set is regenerated, so cache them for a
# week at the browser and let Cloudflare hold them longer at the edge.
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/brand/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# HTML must always be re-checked so a redeploy is picked up immediately.
/
  Cache-Control: public, max-age=0, must-revalidate

/aviso-de-privacidad/
  Cache-Control: public, max-age=0, must-revalidate
