{
  "name": "romotransportes",
  "version": "1.0.0",
  "private": true,
  "description": "Landing page de Romo's Transportes — transporte de carga nacional.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:turbopack": "next build --turbopack",
    "start": "npx serve out -l 4310",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "images": "node scripts/build-images.mjs",
    "brand": "node scripts/build-brand.mjs",
    "docs": "node scripts/build-docs.mjs",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "preview:cf": "wrangler dev"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.5.6",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "wrangler": "^4.133.0"
  }
}
